#!/usr/bin/env bash
# Bring the Ghostty window that shows the review tmux session to the
# front, spawning it on the review space when it doesn't exist. Meant
# as pr-owl's hooks.after_open (PR_OWL_* are set then) and as the first
# step of ws-review. Needs yabai and jq.
#
# Usage: pr-reviews-focus [--cwd DIR]
#   --cwd DIR   working directory of a freshly spawned window
#               (default: $PR_OWL_WORKTREE, else $HOME)
# Environment:
#   PR_OWL_SESSION     tmux session to attach (default: pr-owl config get tmux.session)
#   PR_REVIEWS_TITLE   Ghostty window title to look for / create (default: the session name)
#   PR_REVIEWS_SPACE   yabai space a new window is moved to (default: 9)
#
# Prints `focused <window-id>` or `spawned <window-id>`; exits 1 when
# no window could be found or created.
set -euo pipefail

cwd="${PR_OWL_WORKTREE:-$HOME}"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --cwd) cwd="${2:?pr-reviews-focus: --cwd needs a directory}"; shift 2 ;;
        *) echo "pr-reviews-focus: unknown argument $1" >&2; exit 64 ;;
    esac
done

session="${PR_OWL_SESSION:-$(pr-owl config get tmux.session)}"
title="${PR_REVIEWS_TITLE:-$session}"
space="${PR_REVIEWS_SPACE:-9}"

# Prefix match on the title: shell prompts may append to it through
# OSC title updates after Ghostty sets it.
find_wid() {
    yabai -m query --windows \
        | jq -r --arg t "$title" \
            '.[] | select(.app == "Ghostty" and ((.title // "") | (. == $t or startswith($t + " ") or startswith($t + ":")))) | .id' \
        | head -1
}

wid=$(find_wid)
if [[ -n "$wid" ]]; then
    yabai -m window --focus "$wid"
    echo "focused $wid"
    exit 0
fi

open -na Ghostty --args --title="$title" --working-directory="$cwd" \
    -e "${SHELL:-/bin/zsh}" -lc "exec tmux attach -t '=$session'"
for _ in $(seq 1 25); do
    sleep 0.2
    wid=$(find_wid)
    [[ -n "$wid" ]] && break
done
if [[ -z "$wid" ]]; then
    echo "pr-reviews-focus: Ghostty window '$title' did not appear" >&2
    exit 1
fi
yabai -m window "$wid" --space "$space"
yabai -m window --focus "$wid"
echo "spawned $wid"

#!/usr/bin/env bash
# Hotkey entry point for the pr-owl popup from anywhere on the desktop
# (skhd, Karabiner, ...): make sure the review tmux session exists,
# bring its Ghostty window to the front, then open pr-owl as a tmux
# popup inside it. When Ghostty is already focused, bind the same key
# to `prefix r` in tmux instead — see README.md.
#
# Reads tmux.session, tmux.keepalive_window and default_repo from the
# pr-owl config. pr-owl and pr-reviews-focus are looked up next to this
# script first, because a hotkey daemon's PATH is minimal.
set -euo pipefail

bin="$(cd "$(dirname "$0")" && pwd)"
PATH="$bin:$PATH"

session="$(pr-owl config get tmux.session)"
keepalive="$(pr-owl config get tmux.keepalive_window)"
repo="$(pr-owl config get default_repo)"

if ! tmux has-session -t "=$session" 2>/dev/null; then
    new_session=(tmux new-session -d -s "$session" -n "$keepalive")
    [[ -n "$repo" ]] && new_session+=(-c "$repo")
    "${new_session[@]}"
fi

state="$(pr-reviews-focus --cwd "${repo:-$HOME}")"
# A freshly spawned client needs a moment to attach before a popup can
# render into it.
[[ "$state" == spawned* ]] && sleep 0.4

# run-shell hands one command line to the tmux server's shell, so the
# paths are quoted for it. -d only when default_repo is set: pr-owl
# itself changes into default_repo when started outside a repo.
popup="tmux display-popup -E -w 88% -h 84% -T ' pr-owl '"
if [[ -n "$repo" ]]; then
    printf -v repo_q '%q' "$repo"
    popup+=" -d $repo_q"
fi
printf -v owl_q '%q' "$(command -v pr-owl)"
tmux run-shell -t "=$session" "$popup $owl_q"
